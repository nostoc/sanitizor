import ballerina/io;
import ballerinax/apple.music;

configurable string userToken = ?;
configurable string developerToken = ?;
configurable string storefront = "us";

type RecommendationData record {
    string albumId;
    string albumName;
    string artistName;
    string[] relatedArtists;
    string[] recommendedAlbums;
};

public function main() returns error? {
    music:Client appleMusicClient = check new ({
        auth: {
            token: userToken
        },
        developerToken: developerToken
    });

    io:println("=== Music Recommendation Engine ===");
    io:println("Starting analysis of your personal library...\n");

    music:GetAlbumsFromLibraryQueries libraryQuery = {
        'limit: 10,
        include: ["artists", "tracks"]
    };

    music:LibraryAlbumsResponse libraryAlbums = check appleMusicClient->/me/library/albums(queries = libraryQuery);
    
    io:println(string `Found ${libraryAlbums.data.length()} albums in your library`);
    
    RecommendationData[] recommendations = [];

    foreach music:LibraryAlbums album in libraryAlbums.data {
        io:println(string `\nAnalyzing album: ${album.attributes?.name ?: "Unknown"} by ${album.attributes?.artistName ?: "Unknown Artist"}`);
        
        music:GetAlbumRelationshipFromLibraryQueries artistQuery = {
            'limit: 5,
            include: ["albums"]
        };

        music:LibraryArtistsResponse|error artistsResult = appleMusicClient->/me/library/albums/[album.id]/artists(queries = artistQuery);
        
        string[] relatedArtistNames = [];
        string[] recommendedAlbumTitles = [];
        
        if artistsResult is music:LibraryArtistsResponse {
            foreach music:LibraryArtists artist in artistsResult.data {
                if artist.attributes?.name is string {
                    relatedArtistNames.push(artist.attributes?.name ?: "");
                    
                    music:GetArtistRelationshipFromCatalogQueries catalogQuery = {
                        'limit: 3,
                        include: ["albums"]
                    };
                    
                    music:AlbumsResponse|error catalogAlbums = appleMusicClient->/catalog/[storefront]/artists/[artist.id]/albums(queries = catalogQuery);
                    
                    if catalogAlbums is music:AlbumsResponse {
                        foreach music:Albums catalogAlbum in catalogAlbums.data {
                            if catalogAlbum.attributes is record {} {
                                recommendedAlbumTitles.push("Recommended Album from Catalog");
                            }
                        }
                    }
                }
            }
        }
        
        music:GetAlbumRelationshipFromLibraryQueries trackQuery = {
            'limit: 25,
            include: ["artists", "albums"]
        };

        var tracksResult = appleMusicClient->/me/library/albums/[album.id]/tracks(queries = trackQuery);
        if tracksResult is error {
            io:println(string `Could not retrieve track relationships for album: ${album.attributes?.name ?: "Unknown"}`);
        } else {
            io:println(string `Retrieved track relationship data for analysis`);
        }
        
        RecommendationData recommendation = {
            albumId: album.id,
            albumName: album.attributes?.name ?: "Unknown Album",
            artistName: album.attributes?.artistName ?: "Unknown Artist",
            relatedArtists: relatedArtistNames,
            recommendedAlbums: recommendedAlbumTitles
        };
        
        recommendations.push(recommendation);
        
        io:println(string `Found ${relatedArtistNames.length()} related artists`);
        io:println(string `Generated ${recommendedAlbumTitles.length()} album recommendations`);
    }

    io:println("\n=== PERSONALIZED RECOMMENDATIONS ===");
    
    foreach RecommendationData rec in recommendations {
        io:println(string `\nBased on: "${rec.albumName}" by ${rec.artistName}`);
        io:println("Related Artists:");
        foreach string artist in rec.relatedArtists {
            io:println(string `  - ${artist}`);
        }
        io:println("Recommended Albums:");
        foreach string album in rec.recommendedAlbums {
            io:println(string `  - ${album}`);
        }
    }
    
    io:println(string `\nRecommendation analysis complete! Generated recommendations based on ${recommendations.length()} albums from your library.`);
}